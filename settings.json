{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": true
  },
  "permissions": {
    "allow": ["LS", "WebSearch"],
    "deny": [
      "Read(//**/.env*)",
      "Read(//**/.dev.vars*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/secrets/**)",
      "Read(//**/credentials/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.ssh/**)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/database.yml)",
      "Read(//**/credentials.json)",
      "Read(//**/.npmrc)",
      "Read(//**/.pypirc)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(curl * | sh)",
      "Bash(wget *)",
      "Bash(chmod *)"
    ],
    "ask": ["Bash(dangerouslyDisableSandbox:true)"]
  },
  "model": "opus",
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "auto",
  "verbose": true,
  "voiceEnabled": false
}
